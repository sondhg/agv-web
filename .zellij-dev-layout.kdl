layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    
    tab name="nvim" focus=true {
        pane command="nvim" cwd="/home/sondhg/Documents/agv-web"
    }
    
    tab name="terminal" {
        pane cwd="/home/sondhg/Documents/agv-web"
    }
    
    tab name="opencode" {
        pane command="bash" cwd="/home/sondhg/Documents/agv-web" {
            args "-c" "opencode; exec $SHELL"
        }
    }
    
    tab name="frontend" {
        pane command="bash" cwd="/home/sondhg/Documents/agv-web/agv-gui" {
            args "-c" "pnpm install && pnpm dev; exec $SHELL"
        }
    }
    
    tab name="backend" {
        pane command="bash" cwd="/home/sondhg/Documents/agv-web/agv-system" {
            args "-c" "docker-compose up -d && docker-compose logs -f; exec $SHELL"
        }
    }
}
